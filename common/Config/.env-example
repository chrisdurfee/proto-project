{
    "containerPrefix": "proto",
    "timeZone": "America/Denver",
    "baseUrl": "example.com",
    "siteName": "Example App",
    "contactPhone": "5555555555",
    "mobileUrl": "ex.io",
    "domain": {
        "production": "yourdomain.com",
        "staging": "staging.yourdomain.com",
        "development": "localhost",
        "subdomains": {
            "api": "api",
            "main": "app",
            "crm": "crm",
            "developer": "dev"
        },
        "ssl": true,
        "ports": {
            "development": {
                "api": 8443,
                "main": 3000,
                "crm": 3001,
                "developer": 3002
            }
        }
    },
    "env": "dev",
    "errorReporting": true,
    "errorTracking": true,
    "email": {
        "fromName": "Company Name",
        "address": "app.example.com",
        "default": "notice@app.example.com",
        "securityAlerts": "security-alerts@app.example.com",
        "alertsEnabled": false,
        "smtp": {
            "host": "smtp.mailtrap.io",
            "port": 2525,
            "username": "your_username",
            "password": "your_password",
            "sendingEnabled": true
        }
    },
    "cache": {
        "driver": "RedisDriver",
        "connection": {
            "password": "ProtoRedis2025!CacheSecure#123456789",
            "host": "redis",
            "port": 6379
        }
    },
    "database": "Mysqli",
    "session": "database",
    "supportedFileTypes": [
        "gif",
        "csv",
        "jpeg",
        "jpg",
        "png",
        "webp",
        "svg",
        "txt",
        "pdf",
        "doc",
        "docx",
        "xlsx",
        "pptx",
        "pages",
        "heic",
        "heif",
        "tiff",
        "avif",
        "bmp",
        "jxl",
        "mp3",
        "wav",
        "mp4",
        "mov"
    ],
    "connections": {
        "default": {
            "dev": {
                "username": "proto_app_user",
                "password": "ProtoApp2025!SecureDbPass#789",
                "host": "mariadb",
                "database": "proto",
                "port": 3306
            },
            "prod": {
                "username": "proto_app_user",
                "password": "CHANGE_ME_BEFORE_DEPLOYING",
                "host": "mariadb",
                "database": "proto",
                "port": 3306
            },
            "testing": {
                "username": "root",
                "password": "root",
