                "database": "mysql",
                "port": 3306
            },
            "prod": {
                "username": "proto_slowlog_maint",
                "password": "CHANGE_ME_BEFORE_DEPLOYING",
                "host": "mariadb",
                "database": "mysql",
                "port": 3306
            }
        }
    },
    "files": {
        "local": {
            "path": "/public/files/",
            "main": {
                "path": "/public/files/main/"
            },
            "users": {
                "path": "/public/files/users/profile/"
            },
            "client": {
                "path": "/public/files/client/profile/"
            },
            "conversation": {
                "path": "/public/files/client/conversation/"
            },
            "messages": {
                "path": "/public/files/messages/"
            },
            "groups": {
                "path": "/public/files/groups/"
            },
            "forum": {
                "path": "/public/files/forum/"
            },
            "events": {
                "path": "/public/files/events/"
            }
        },
        "amazon": {
            "s3": {
                "credentials": {
                    "secretKey": "",
                    "accessKey": ""
                },
                "bucket": {
                    "uploads": {
                        "secure": true,
                        "name": "main",
                        "path": "main/",
                        "region": "",
                        "version": "latest"
                    }
                }
            },
            "cloudFront": {
                "url": "",
                "keyPairId": "",
                "version": "",
                "region": "",
                "credentials": {
                    "secretKey": "",
                    "accessKey": ""
                }
            }
        }
    },
    "router": {
        "basePath": "/api/",
        "maxRequests": 1200
    },
    "services": [],
    "modules": [
        "User\\UserModule",
        "Auth\\AuthModule",
        "Developer\\DeveloperModule",
        "Client\\ClientModule",
        "Tracking\\TrackingModule"
    ],
    "apis": {
        "google": {
            "clientId": "YOUR_CLIENT_ID",
