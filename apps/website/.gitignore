# Generated by scripts/render-legal-pages.js from the content modules in
# apps/main/src/modules/legal/content. Committing them would let the static
# copy drift from the copy the app renders, which is the whole problem this
# generator exists to prevent.
legal/*.html

# Emitted from src/css/styles.css by the emitSiteCss step in vite.config.js.
public/site.css

node_modules/
