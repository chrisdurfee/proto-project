# Cron run log cleanup — runs daily at 04:15
# Deletes expired cron_runs rows based on each job's retention policy.
# Logs are written to /var/log/cron-cleanup.log inside the container.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

15 4 * * * www-data cd /var/www/html && php infrastructure/scripts/run-routine.php "Common\\Automation\\Processes\\CronCleanupRoutine" >> /var/log/cron-cleanup.log 2>&1
