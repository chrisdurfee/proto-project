# Docker Environment Configuration
#
# DO NOT hand-edit secrets here. The real infrastructure/.env is generated from
# the single source of truth (common/Config/.env) by running:
#   ./infrastructure/scripts/run.sh sync-config
#
# This example only documents the variables Docker Compose expects.
# NEVER commit real secrets.

# Database Configuration
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=proto
# Least-privilege application user (NOT root)
DB_USERNAME=proto_app_user
# Generated from common/Config/.env -> connections.default.dev.password
DB_PASSWORD=
# Generated by sync-config (dev default: root). Set a real value in production.
DB_ROOT_PASSWORD=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
# Generated from common/Config/.env -> cache.connection.password
REDIS_PASSWORD=

# Application Environment
APP_ENV=development

# Automation Controls
# Set to 'true' to automatically run migrations on container startup
AUTO_MIGRATE=true
# Run the in-container cron scheduler. Keep true for single-container dev.
# For an optional dedicated scheduler: set RUN_CRON=false and
# `docker compose --profile scheduler up -d`.
RUN_CRON=true

# Domain Configuration (used by sync-config.js)
DOMAIN_NAME=localhost

# Development Settings
CORS_ENABLED=true
CORS_ORIGINS=https://localhost:3000,https://localhost:3001,https://localhost:3002
